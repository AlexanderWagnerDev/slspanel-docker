# Copy this file to .env and edit it. Do not commit the real .env.
LANG=en
TZ=UTC
SLS_API_URL=http://sls-api-url:8789
SLS_API_KEY=yourapikey
SRT_PUBLISH_PORT=4001
SRT_PLAYER_PORT=4000
SRTLA_PUBLISH_PORT=5000
SLS_DOMAIN_IP=your-sls-domain-sls-domain-ip
# Optional: internal statistics host used by the panel; defaults to SLS_DOMAIN_IP
# SLS_STATS_DOMAIN_IP=stats.internal.example
# Optional: public host used in copied statistics URLs; defaults to SLS_STATS_DOMAIN_IP
# SLS_STATS_PUBLIC_DOMAIN_IP=stats.example.com
SLS_STATS_PORT=8789
SLS_STATS_SCHEME=http
REQUIRE_LOGIN=True
SLS_ADMIN_USERNAME=admin
# Set a strong password; startup fails when REQUIRE_LOGIN=True and this is empty or the literal example password.
SLS_ADMIN_PASSWORD=password

# Optional: Comma-separated list of trusted origins for CSRF protection
# Required when running behind a reverse proxy (e.g. Cloudflare Tunnel, Nginx)
# CSRF_TRUSTED_ORIGINS=https://mydomain.com,https://*.trycloudflare.com

# Optional: Enable HTTPS detection via X-Forwarded-Proto header (true/false)
# SECURE_PROXY_SSL_HEADER=true
